{% extends 'base.html.twig' %}

{% set step_info = {
  basics: { title: 'Basics',       subtitle: 'name, color',     description: 'Display name and a color for visual differentiation.' },
  jira:   { title: 'Jira',         subtitle: 'connection',      description: 'Beacon pulls tickets from Jira each morning. Test the connection before continuing.' },
  hours:  { title: 'Daily target', subtitle: 'hours per day',   description: 'How much focused time will you allocate to this project each day?' },
  links:  { title: 'Quick links',  subtitle: 'optional',        description: 'Bookmarks for this project. You can skip and add them later.' },
  review: { title: 'Review',       subtitle: 'confirm',         description: 'Looks good? Click create to finish.' },
} %}

{% set step_routes = {
  basics: 'project_wizard_basics',
  jira:   'project_wizard_jira',
  hours:  'project_wizard_hours',
  links:  'project_wizard_links',
  review: 'project_wizard_review',
} %}

{% set current = step_info[step.name] %}
{% set active_page = 'projects' %}

{% block title %}Beacon · new project · {{ current.title|lower }}{% endblock %}

{% block body %}
<div class="app-shell">
  <header class="app-shell__topbar">
    <a href="{{ path('home') }}" class="app-shell__brand" title="beacon">
      <span class="app-shell__brand-mark">B</span>
      <span class="app-shell__brand-name">beacon</span>
    </a>

    <nav class="app-shell__nav">
      <a href="{{ path('home') }}" class="nav-link">today</a>
      <a href="{{ path('projects_index') }}" class="nav-link nav-link--active">projects</a>
      <a href="#" class="nav-link">schedule</a>
    </nav>

    <span class="app-shell__spacer"></span>

    <span class="app-shell__hint">
      press <kbd class="kbd-chip">j</kbd> / <kbd class="kbd-chip">k</kbd> to navigate
    </span>

    <a href="#" class="app-shell__icon-btn" title="Settings">⚙</a>
    <button type="button" class="app-shell__theme-indicator" title="Dark mode (MVP is dark-only)">☾ dark</button>
  </header>

  <div class="app-shell__content app-shell__content--with-aside">
    <aside class="app-shell__aside">
      <div class="wiz-rail__summary">
        <span class="wiz-rail__kicker">new project</span>
        <span class="wiz-rail__title">{{ step.total }} steps</span>
        <span class="wiz-rail__sub">~2 minutes</span>
      </div>

      <hr class="rail-section__divider">
      <h3 class="rail-section__heading">What you'll need</h3>
      <ul class="wiz-rail__list">
        <li>Jira base URL</li>
        <li>Board ID</li>
        <li>Daily target hours</li>
      </ul>
    </aside>

    <main class="app-shell__main">
      <nav class="wiz-breadcrumb">
        <a href="{{ path('projects_index') }}">projects</a>
        <span class="dimmest">/</span>
        <span class="wiz-breadcrumb__current">new</span>
      </nav>

      <header class="page-header">
        <div class="page-header__inner">
          <span class="page-header__kicker">setup</span>
          <h1 class="page-header__title">New project</h1>
          <span class="page-header__subtitle">connect a Jira board, set daily hours, save links</span>
        </div>
      </header>

      <div class="wiz-grid">
        <ol class="wiz-stepper">
          {% for s in step.all %}
            {% set info = step_info[s.name] %}
            {% set state_cls = s.active ? 'wiz-stepper__btn--active' : (s.complete ? 'wiz-stepper__btn--done' : 'wiz-stepper__btn--upcoming') %}
            <li class="wiz-stepper__item">
              {% if s.complete %}
                <a href="{{ path(step_routes[s.name]) }}" class="wiz-stepper__btn {{ state_cls }}">
                  <span class="wiz-stepper__num">✓</span>
                  <span class="wiz-stepper__labels">
                    <span>{{ info.title }}</span>
                    <span class="wiz-stepper__sub">{{ info.subtitle }}</span>
                  </span>
                </a>
              {% else %}
                <span class="wiz-stepper__btn {{ state_cls }}">
                  <span class="wiz-stepper__num">{{ s.index }}</span>
                  <span class="wiz-stepper__labels">
                    <span>{{ info.title }}</span>
                    <span class="wiz-stepper__sub">{{ info.subtitle }}</span>
                  </span>
                </span>
              {% endif %}
            </li>
          {% endfor %}
        </ol>

        <div>
          <div class="wiz-card">
            <div class="wiz-card__step">step {{ step.index }} of {{ step.total }}</div>
            <h2 class="wiz-card__title">{{ current.title }}</h2>
            <p class="wiz-card__desc">{{ current.description }}</p>
            {% block step_body %}{% endblock %}
          </div>

          {% block step_actions %}{% endblock %}
        </div>
      </div>
    </main>
  </div>
</div>
{% endblock %}
