{% extends 'projects/wizard/_layout.html.twig' %}

{% block step_body %}
<form method="post" novalidate>
  <label class="wiz-field">
    <span class="wiz-field__label">Base URL</span>
    <input class="wiz-input{{ errors.jira_base_url is defined ? ' wiz-input--error' : '' }}" type="text" name="jira_base_url" required placeholder="https://yourorg.atlassian.net" value="{{ data.base_url }}" autofocus>
    {% if errors.jira_base_url is defined %}
      <span class="wiz-field__error">{{ errors.jira_base_url }}</span>
    {% else %}
      <span class="wiz-field__hint">The Atlassian host shared by every board on this project.</span>
    {% endif %}
  </label>

  <div class="wiz-field">
    <span class="wiz-field__label">Boards</span>
    <span class="wiz-field__hint">One or more Jira project keys (e.g. <span class="mono">ABC</span>). Paste a board URL and we'll pull the key out. Optional label and per-board JQL override.</span>
    {% if errors.boards is defined %}
      <span class="wiz-field__error">{{ errors.boards }}</span>
    {% endif %}
  </div>

  {% include 'projects/_board-rows.html.twig' with {
    boards: data.boards,
    board_errors: errors.board_rows is defined ? errors.board_rows : null,
    test_url: path('project_wizard_jira_test'),
  } %}

  <div class="wiz-test">
    {% include 'projects/wizard/_jira-test-result.html.twig' with { result: test_result } %}
  </div>
{% endblock %}

{% block step_actions %}
  <div class="wiz-actions">
    <button type="submit" class="b-btn b-btn--ghost" formaction="{{ path('project_wizard_cancel') }}" formnovalidate
            onclick="return confirm('Discard this new project?')">cancel</button>
    <span class="wiz-actions__spacer"></span>
    <a href="{{ path('project_wizard_basics') }}" class="b-btn">← back</a>
    <button type="submit" class="b-btn b-btn--primary">next →</button>
  </div>
</form>
{% endblock %}
