<div id="proj-tickets-section">
  <h2 class="proj-tickets__heading">
    Tickets <span class="proj-tickets__count">· {{ ticket_count }} matching JQL filter</span>
  </h2>

  {% if tickets is empty %}
    <div class="proj-tickets__empty">
      No tickets match the configured JQL filter.
    </div>
  {% else %}
    <div class="proj-tickets__table-wrap">
      <table class="proj-tickets__table">
        <thead>
          <tr>
            <th class="proj-tickets__col--key">key</th>
            <th>summary</th>
            <th class="proj-tickets__col--status">status</th>
            {% if show_boards|default(false) %}<th class="proj-tickets__col--board">board</th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for ticket in tickets %}
            <tr{% if ticket.is_new %} class="proj-tickets__row--new"{% endif %}>
              <td>
                <div class="proj-tickets__keycell">
                  <a class="proj-tickets__key"
                     href="{{ project.jira_base_url }}/browse/{{ ticket.key }}"
                     target="_blank" rel="noopener">{{ ticket.key }}</a>
                  {% if ticket.is_new %}<span class="ticket-new-badge">new</span>{% endif %}
                </div>
              </td>
              <td>{{ ticket.summary }}</td>
              <td>
                <span class="pill {% if ticket.status == 'In Progress' %}pill--in-progress{% elseif ticket.status == 'Blocked' %}pill--blocked{% else %}pill--neutral{% endif %}">
                  {{ ticket.status }}
                </span>
              </td>
              {% if show_boards|default(false) %}
                <td>{% if ticket.board %}<span class="proj-tickets__board">{{ ticket.board }}</span>{% endif %}</td>
              {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  <div class="proj-detail__cache-note">
    cached from Jira · last refreshed {{ last_refreshed }}
  </div>
</div>
