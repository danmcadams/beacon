{% extends 'base.html.twig' %}

{% block title %}Beacon · edit · {{ project.name }}{% endblock %}

{% block body %}
{% embed '_partials/_app-shell.html.twig' with { active_page: 'projects' } %}

  {% block aside %}
    <div class="proj-rail__header">
      <span class="rail-block__kicker">editing</span>
      <div class="proj-rail__name-row">
        <span class="proj-rail__swatch" style="background: {{ project.color }};"></span>
        <span class="proj-rail__name">{{ project.name }}</span>
      </div>
    </div>

    <hr class="rail-divider">
    <div class="rail-section__body">
      <label class="wiz-field">
        <span class="wiz-field__label">Status</span>
        <select class="wiz-input proj-edit__select--status" name="status" form="edit-project-form">
          <option value="active"{% if form.status == 'active' %} selected{% endif %}>active</option>
          <option value="on_hold"{% if form.status == 'on_hold' %} selected{% endif %}>on hold</option>
          {% if form.status == 'archived' %}
            <option value="archived" selected>archived</option>
          {% endif %}
        </select>
        {% if errors.status is defined %}
          <span class="wiz-field__error">{{ errors.status }}</span>
        {% endif %}
      </label>

      <label class="wiz-field">
        <span class="wiz-field__label">Daily target hours</span>
        <input class="wiz-input proj-edit__input--hours" type="number" name="daily_hours_target" step="0.5" min="0" max="24" value="{{ form.daily_hours_target }}" form="edit-project-form">
        {% if errors.daily_hours_target is defined %}
          <span class="wiz-field__error">{{ errors.daily_hours_target }}</span>
        {% endif %}
      </label>

      <label class="wiz-field">
        <span class="wiz-field__label">Color</span>
        <div class="wiz-swatches">
          {% for c in swatch_colors %}
            <button type="button"
                    class="wiz-swatch{{ form.color|lower == c ? ' wiz-swatch--active' : '' }}"
                    style="background: {{ c }}"
                    title="{{ c }}"
                    onclick="document.getElementById('color-input').value='{{ c }}'; this.parentNode.querySelectorAll('.wiz-swatch').forEach(function(s){s.classList.remove('wiz-swatch--active')}); this.classList.add('wiz-swatch--active');"></button>
          {% endfor %}
        </div>
        <input type="hidden" id="color-input" name="color" value="{{ form.color }}" form="edit-project-form">
        {% if errors.color is defined %}
          <span class="wiz-field__error">{{ errors.color }}</span>
        {% endif %}
      </label>
    </div>
  {% endblock %}

  {% block main %}
    <div class="proj-detail__breadcrumb">
      <a href="{{ path('projects_index') }}">projects</a>
      <span class="dimmest">/</span>
      <a href="{{ path('project_detail', { id: project.id }) }}">{{ project.name }}</a>
      <span class="dimmest">/</span>
      <span style="color: var(--fg);">edit</span>
    </div>

    <header class="page-header">
      <div class="page-header__inner">
        <span class="page-header__kicker">settings</span>
        <h1 class="page-header__title">Edit project</h1>
        <span class="page-header__subtitle">single-form view · all fields editable</span>
      </div>
    </header>

    <form id="edit-project-form" method="post" action="{{ path('project_edit', { id: project.id }) }}" novalidate>
      <div class="proj-edit__card">

        {# ── Basics ─────────────────────────────── #}
        <h3 class="proj-edit__section-heading">Basics</h3>

        <label class="wiz-field">
          <span class="wiz-field__label">Name</span>
          <input class="wiz-input" type="text" name="name" maxlength="100" required value="{{ form.name }}">
          {% if errors.name is defined %}
            <span class="wiz-field__error">{{ errors.name }}</span>
          {% endif %}
        </label>

        <label class="wiz-field">
          <span class="wiz-field__label">Description (optional)</span>
          <textarea class="wiz-textarea" name="description">{{ form.description }}</textarea>
        </label>

        <label class="wiz-field">
          <span class="wiz-field__label">Briefing context (optional)</span>
          <span class="wiz-field__hint">Free-form notes the AI briefing should know about — planning notes, current focus, recent decisions. Plain text, appended verbatim to the prompt.</span>
          <textarea class="wiz-textarea" name="briefing_context" rows="8">{{ form.briefing_context }}</textarea>
        </label>

        <hr class="proj-edit__divider">

        {# ── Quick Links ──────────────────────────── #}
        <h3 class="proj-edit__section-heading">Quick Links</h3>

        <div id="link-rows">
          {% set rows = form.links is empty ? [{id: '', label: '', url: ''}] : form.links %}
          {% for i, row in rows %}
            {% set rowError = (errors.links is defined and errors.links[i] is defined) ? errors.links[i] : null %}
            <div class="wiz-link-row">
              <input type="hidden" name="link_id[]" value="{{ row.id }}">
              <input class="wiz-input wiz-input--label{{ rowError and rowError.field == 'label' ? ' wiz-input--error' : '' }}" type="text" name="link_label[]" placeholder="Label" maxlength="100" value="{{ row.label }}">
              <input class="wiz-input wiz-input--url{{ rowError and rowError.field == 'url' ? ' wiz-input--error' : '' }}" type="url" name="link_url[]" placeholder="https://..." maxlength="500" value="{{ row.url }}">
              <button type="button" class="b-btn b-btn--ghost" onclick="this.parentNode.remove()">−</button>
            </div>
            {% if rowError %}
              <span class="wiz-field__error">{{ rowError.message }}</span>
            {% endif %}
          {% endfor %}
        </div>

        <button type="button" class="b-btn" onclick="
          const div = document.createElement('div');
          div.className = 'wiz-link-row';
          div.innerHTML = '<input type=\'hidden\' name=\'link_id[]\' value=\'\'><input class=\'wiz-input wiz-input--label\' type=\'text\' name=\'link_label[]\' placeholder=\'Label\' maxlength=\'100\'><input class=\'wiz-input wiz-input--url\' type=\'url\' name=\'link_url[]\' placeholder=\'https://...\' maxlength=\'500\'><button type=\'button\' class=\'b-btn b-btn--ghost\' onclick=\'this.parentNode.remove()\'>−</button>';
          document.getElementById('link-rows').appendChild(div);
        ">+ add link</button>

        <hr class="proj-edit__divider">

        {# ── Jira ────────────────────────────────── #}
        <h3 class="proj-edit__section-heading">Jira</h3>

        <label class="wiz-field">
          <span class="wiz-field__label">Base URL</span>
          <input class="wiz-input{{ errors.jira_base_url is defined ? ' wiz-input--error' : '' }}" type="text" name="jira_base_url" value="{{ form.jira_base_url }}"
                 placeholder="https://yourorg.atlassian.net">
          <span class="wiz-field__hint">The Atlassian host shared by every board on this project.</span>
          {% if errors.jira_base_url is defined %}
            <span class="wiz-field__error">{{ errors.jira_base_url }}</span>
          {% endif %}
        </label>

        <div class="wiz-field">
          <span class="wiz-field__label">Boards</span>
          <span class="wiz-field__hint">One or more Jira project keys (e.g. <span class="mono">ABC</span>). Paste a board URL and we'll pull the key out. Optional label and per-board JQL override.</span>
          {% if errors.boards is defined %}
            <span class="wiz-field__error">{{ errors.boards }}</span>
          {% endif %}
        </div>

        <div id="board-rows">
          {% set boardRows = form.boards is empty ? [{id: '', key: '', label: '', jql: ''}] : form.boards %}
          {% for i, row in boardRows %}
            {% set boardError = (errors.board_rows is defined and errors.board_rows[i] is defined) ? errors.board_rows[i] : null %}
            <div class="board-row">
              <input type="hidden" name="board_id[]" value="{{ row.id }}">
              <input class="wiz-input board-row__key{{ boardError ? ' wiz-input--error' : '' }}" type="text" name="board_key[]" placeholder="Project key" value="{{ row.key }}">
              <input class="wiz-input board-row__label" type="text" name="board_label[]" placeholder="Label (optional)" maxlength="100" value="{{ row.label }}">
              <input class="wiz-input board-row__jql" type="text" name="board_jql[]" placeholder="JQL override (optional)" value="{{ row.jql }}">
              <button type="button" class="b-btn board-row__test" data-test-url="{{ path('project_edit_jira_test', { id: project.id }) }}">test</button>
              <button type="button" class="b-btn b-btn--ghost" onclick="this.closest('.board-row').remove()">−</button>
            </div>
            {% if boardError %}
              <span class="wiz-field__error">{{ boardError }}</span>
            {% endif %}
          {% endfor %}
        </div>

        <template id="board-row-template">
          <div class="board-row">
            <input type="hidden" name="board_id[]" value="">
            <input class="wiz-input board-row__key" type="text" name="board_key[]" placeholder="Project key">
            <input class="wiz-input board-row__label" type="text" name="board_label[]" placeholder="Label (optional)" maxlength="100">
            <input class="wiz-input board-row__jql" type="text" name="board_jql[]" placeholder="JQL override (optional)">
            <button type="button" class="b-btn board-row__test" data-test-url="{{ path('project_edit_jira_test', { id: project.id }) }}">test</button>
            <button type="button" class="b-btn b-btn--ghost" onclick="this.closest('.board-row').remove()">−</button>
          </div>
        </template>

        <button type="button" class="b-btn" onclick="
          const tpl = document.getElementById('board-row-template');
          document.getElementById('board-rows').appendChild(tpl.content.cloneNode(true));
        ">+ add board</button>

        <div class="wiz-test">
          {% include 'projects/wizard/_jira-test-result.html.twig' with { result: test_result } %}
        </div>

      </div>{# /.proj-edit__card #}

      <div class="proj-edit__actions">
        <a href="{{ path('project_detail', { id: project.id }) }}" class="b-btn b-btn--ghost">cancel</a>
        <span class="proj-edit__actions-spacer"></span>
        <button type="submit" class="b-btn b-btn--primary">✓ save changes</button>
      </div>
    </form>

    <section class="danger-zone" aria-labelledby="danger-zone-title">
      <h2 id="danger-zone-title" class="danger-zone__heading">Danger zone</h2>
      <div class="danger-zone__card">
        <div class="danger-zone__row">
          <div class="danger-zone__info">
            <div class="danger-zone__info-title">Archive this project</div>
            <div class="danger-zone__info-desc">Stops briefing generation and hides the project from the active list. Reactivate by setting the Status field to active.</div>
          </div>
          <button type="button" class="b-btn b-btn--danger"
                  hx-post="{{ path('project_archive', { id: project.id }) }}"
                  hx-confirm="Archive {{ form.name ?: project.name }}? Briefings will stop generating until you reactivate it.">Archive project</button>
        </div>
        <div class="danger-zone__row">
          <div class="danger-zone__info">
            <div class="danger-zone__info-title">Delete this project</div>
            <div class="danger-zone__info-desc">Permanently removes the project plus every briefing, ticket, and quick link tied to it. Cannot be undone.</div>
          </div>
          <button type="button" class="b-btn b-btn--danger"
                  hx-post="{{ path('project_delete', { id: project.id }) }}"
                  hx-confirm="Permanently delete {{ form.name ?: project.name }}? This removes the project plus all its briefings, tickets, and quick links. Cannot be undone.">Delete project</button>
        </div>
      </div>
    </section>

  {% endblock %}

{% endembed %}
{% endblock %}
