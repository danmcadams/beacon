{% extends 'base.html.twig' %}

{% block title %}Beacon · today{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    (function () {
      function tick() {
        document.body.dispatchEvent(new CustomEvent('rail-tick'));
      }
      const now = new Date();
      const msToNextMinute = (60 - now.getSeconds()) * 1000 - now.getMilliseconds();
      setTimeout(function () {
        tick();
        setInterval(tick, 60000);
      }, msToNextMinute);
    })();
  </script>
{% endblock %}

{% block body %}
{% embed '_partials/_app-shell.html.twig' with { active_page: 'today' } %}

  {% block aside %}
    {{ include('home/_rail-now.html.twig') }}

    <hr class="rail-divider">
    <h3 class="rail-section__title">Allocation</h3>
    <div class="rail-section__body">
      <div class="allocation__bar">
        {% for p in projects %}
          <span class="allocation__seg" style="flex: {{ p.hours }}; background: {{ p.color }};" title="{{ p.name }} · {{ p.hours }}h"></span>
        {% endfor %}
      </div>
      {% for p in projects %}
        <div class="allocation__row">
          <span class="allocation__swatch" style="background: {{ p.color }};"></span>
          <span class="allocation__name">{{ p.name }}</span>
          <span class="allocation__hours">{{ p.hours|number_format(1) }}h</span>
        </div>
      {% endfor %}
      <div class="allocation__total">
        <span class="allocation__total-label">total</span>
        <span class="allocation__total-value">{{ total_hours|number_format(1) }}h</span>
      </div>
    </div>

    <hr class="rail-divider">
    <h3 class="rail-section__title">Briefing</h3>
    <div class="rail-section__body briefing-meta">
      <div class="briefing-meta__row">generated <span class="briefing-meta__strong">{{ briefing.generated_at_long }}</span></div>
      <div class="briefing-meta__row briefing-meta__dim">{{ briefing.model }}</div>
      <div class="briefing-meta__row briefing-meta__dim">{{ briefing.input_tokens }} in / {{ briefing.output_tokens }} out</div>
      <div class="briefing-meta__actions">
        <button type="button" class="btn btn--primary"
                hx-post="{{ path('briefings_regenerate_all') }}"
                hx-disabled-elt="this"
                hx-indicator=".project-stack"><span class="spin-on-busy">↻</span> regenerate</button>
        <a href="{{ path('yesterday') }}" class="btn btn--link">← yesterday</a>
      </div>
    </div>
  {% endblock %}

  {% block main %}
    <header class="page-header">
      <div class="page-header__inner">
        <span class="page-header__kicker">today</span>
        <h1 class="page-header__title">Briefings</h1>
        <span class="page-header__subtitle">{{ projects|length }} projects · {{ total_hours|number_format(1) }}h allocated</span>
      </div>
      <span class="page-header__spacer"></span>
      <button type="button" class="btn btn--ghost" id="toggle-jira-tickets">Show Jira Tickets</button>
    </header>

    <div class="project-stack project-stack--hide-tickets" id="project-stack">
      {% for project in projects %}
        {% include '_partials/_project-card.html.twig' with { project: project } only %}
      {% endfor %}
    </div>

    <script>
      (function () {
        var stack = document.getElementById('project-stack');
        var btn = document.getElementById('toggle-jira-tickets');
        if (!stack || !btn) return;
        var KEY = 'beacon.today.showJiraTickets';
        function apply(show) {
          stack.classList.toggle('project-stack--hide-tickets', !show);
          btn.textContent = show ? 'Hide Jira Tickets' : 'Show Jira Tickets';
        }
        apply(localStorage.getItem(KEY) === '1');
        btn.addEventListener('click', function () {
          var show = stack.classList.contains('project-stack--hide-tickets');
          localStorage.setItem(KEY, show ? '1' : '0');
          apply(show);
        });
      })();
    </script>
  {% endblock %}

{% endembed %}
{% endblock %}
