{# Project card. Required: project = {
     name, slug, color, hours, ticket_count,
     briefing_html, briefing_status,
     tickets: [{key, summary, priority}]
   }
#}
<article class="project-card" style="--pc: {{ project.color }}">
  <div class="project-card__rule"></div>
  <div class="project-card__tint"></div>

  <header class="project-card__header">
    <a href="{{ path('project_detail', { id: project.id }) }}" class="project-card__name">
      {{ project.name }} <span class="project-card__arrow">↗</span>
    </a>
    <span class="project-card__meta">
      {{ project.hours }}h <span class="project-card__meta-dim">·</span>
      <span class="project-card__meta-dim">{{ project.ticket_count }} tickets</span>
    </span>
    <span class="project-card__spacer"></span>
    <span class="project-card__slug">{{ project.slug }}</span>
    <a href="#" class="project-card__regen" title="Regenerate">↻</a>
  </header>

  <div class="project-card__body">
    <div class="md">
      {{ project.briefing_html|raw }}
    </div>
  </div>

  {% if project.tickets is defined and project.tickets|length > 0 %}
    {{ include('_partials/_card-tickets.html.twig') }}
  {% endif %}
</article>
