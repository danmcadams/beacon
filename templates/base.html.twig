<!DOCTYPE html>
<html lang="en" data-theme="dark" id="root">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <script>document.getElementById('root').dataset.theme=localStorage.getItem('theme')||'dark';</script>
        <title>{% block title %}Beacon{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <script id="notif-data" type="application/json">{{ notification_data_json() }}</script>
        {% block body %}{% endblock %}
    </body>
</html>
