<form id="app-settings-form"
  hx-post="{{ path('settings_app_save') }}"
  hx-target="#app-settings-form"
  hx-swap="outerHTML">
  <div class="settings-field">
    <label class="settings-field__label" for="timezone">Timezone</label>
    <div style="display: flex; gap: 10px; align-items: center;">
      <select class="settings-select" name="timezone" id="timezone">
        {% for value, label in timezones %}
          <option value="{{ value }}"{{ value == app_timezone ? ' selected' : '' }}>{{ label }}</option>
        {% endfor %}
      </select>
      <button type="submit" class="b-btn b-btn--primary">Save</button>
      <span style="color: var(--ok); font-size: var(--fs-12);">✓ saved</span>
    </div>
  </div>

  <div class="settings-field" style="margin-top: 14px;">
    <label class="settings-field__label" for="notification_leads">Lead-time alerts</label>
    <p class="dimmer" style="font-size: var(--fs-12); margin: 4px 0 8px;">
      Minutes before a block to fire a browser notification. Enter comma-separated values (e.g. <code class="settings-code">15, 10, 5</code>). Leave blank to disable. Max 6 values, each between 1–240.
    </p>
    <input class="settings-input" type="text" name="notification_leads"
           id="notification_leads" value="{{ notification_leads }}"
           placeholder="15, 10, 5" style="width: 180px;">
  </div>
</form>
