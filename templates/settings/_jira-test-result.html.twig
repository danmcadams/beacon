<span id="jira-test-result-{{ project_id }}" style="display: inline-flex; align-items: center; gap: 8px;">
  <button type="button" class="b-btn"
    hx-post="{{ path('settings_jira_test', { id: project_id }) }}"
    hx-target="#jira-test-result-{{ project_id }}"
    hx-swap="outerHTML">↻ test</button>
  {% if result.isOk() %}
    <span style="color: var(--ok); font-size: var(--fs-12);">✓ {{ result.ticketCount }} ticket{{ result.ticketCount != 1 ? 's' : '' }}</span>
  {% elseif result.state == 'missing_credentials' %}
    <span style="color: var(--warn); font-size: var(--fs-12);">⚠ no credentials</span>
  {% else %}
    <span style="color: var(--err); font-size: var(--fs-12);">✗ {{ result.message }}</span>
  {% endif %}
</span>
